# Bu dosyayı ".env" adıyla kopyalayın. .env Git'e eklenmez.

# development | production
# (python run.py tanımlı değilse otomatik olarak development kullanır)
ENVIRONMENT=development

# Production'da ZORUNLU. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Varsayılan: yerel SQLite. Postgres için örn:
# DATABASE_URL=postgresql+asyncpg://edux_user:GUCLU_SIFRE@localhost:5432/edux_db
DATABASE_URL=sqlite+aiosqlite:///./oltvia.db

# Frontend origin'leri (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# JWT geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Boş bırakılırsa: development'ta true, production'da false.
# EXPOSE_DEMO_OTP production'da açılamaz.
# SEED_DEMO_DATA=
# EXPOSE_DEMO_OTP=
